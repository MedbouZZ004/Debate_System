# WSD Debate System - Environment Configuration Template
# Copy this file to .env and fill in your values

# ============================================
# REQUIRED: Groq API Configuration
# ============================================
# Get your API key from https://console.groq.com
GROQ_API_KEY=your_api_key_here

# ============================================
# OPTIONAL: LLM Configuration
# ============================================
# Model to use (default: mixtral-8x7b-32768)
GROQ_MODEL=mixtral-8x7b-32768

# Temperature for response creativity (0.0 - 1.0)
# Lower = more deterministic, Higher = more creative
# Default: 0.7
GROQ_TEMPERATURE=0.7

# Maximum tokens for response (1 - 8192)
# Increase for longer, more detailed responses
# Default: 8192
GROQ_MAX_TOKENS=8192

# ============================================
# OPTIONAL: Debate Configuration
# ============================================
# Number of main arguments per side (1 - 10)
# Default: 3
DEFAULT_NUM_ARGUMENTS=3

# Number of rebuttals per side (1 - 10)
# Default: 3
DEFAULT_NUM_REBUTTALS=3

# ============================================
# OPTIONAL: Logging Configuration
# ============================================
# Log level: DEBUG, INFO, WARNING, ERROR
# Default: INFO
LOG_LEVEL=INFO

# Path to log file
# Default: logs/wsd_debate.log
LOG_FILE=logs/wsd_debate.log

# Enable debug mode for detailed logging
# Default: false
DEBUG_MODE=false

# ============================================
# OPTIONAL: System Configuration
# ============================================
# Timeout for API calls in seconds (1 - 600)
# Default: 300 (5 minutes)
TIMEOUT_SECONDS=300

# Maximum retry attempts for failed requests (1 - 10)
# Default: 3
MAX_RETRIES=3

# Enable parallel execution of agents
# Default: true
PARALLEL_EXECUTION=true

# ============================================
# NOTES
# ============================================
# 1. Never commit this file with real API keys
# 2. Keep GROQ_API_KEY private and secure
# 3. Adjust settings based on your needs
# 4. See SETUP.md for detailed configuration guide
